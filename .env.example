# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Management API (production) — nécessaires pour `npm run migrate`
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_ID=

# Inscription (URL secrète)
SIGNUP_SECRET_TOKEN=

# API d'administration (/api/drafts, /api/catalog) — clé Bearer des agents de collecte et de `npm run verify:drafts`
ADMIN_API_KEY=
# Site visé par `npm run verify:drafts` (défaut : http://localhost:3000) et par l'agent des chantiers (défaut : https://debats.co)
DEBATS_URL=
# Contributeur au nom duquel l'API d'administration écrit dans le journal (métiers, affiliations, organisations) : l'id d'une ligne de `contributors`, de rang Éloquent au moins
ADMIN_CONTRIBUTOR_ID=

# Chantiers (/admin/chantiers) : l'agent Managed Agents, son environnement et son coffre, créés par `npm run chantier:setup` (README, ADR 0003)
CHANTIER_AGENT_ID=
CHANTIER_ENVIRONMENT_ID=
CHANTIER_VAULT_ID=
# Lu par le script seulement : le dossier des skills de contenu à publier sur le compte Anthropic (un sous-dossier par skill, hors dépôt)
CHANTIER_SKILLS_DIR=
# Facultatif : plafond par session en cents (défaut 2000), dépôt monté (défaut https://github.com/Debats/debats), jeton si le dépôt est privé
CHANTIER_BUDGET_CENTS=
CHANTIER_REPOSITORY_URL=
CHANTIER_REPOSITORY_TOKEN=

# Import de contenu (optionnel)
CONTENT_AUTHOR_ID=00000000-0000-0000-0000-000000000001

# SMTP (envoi d'emails — feedback visiteurs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sentry (production uniquement — ne pas définir en dev pour garder Sentry inactif)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Connexion Postgres directe de la couche d'écriture (Prisma). Local : base de supabase start ; prod : pooler Supabase
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64322/postgres

# Relecture assistée du formulaire de prise de position (ADR 0002). Sans clé, la relecture se dit indisponible
ANTHROPIC_API_KEY=
