# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Management API (production) — nécessaires pour `npm run migrate` et `npm run supabase:config:push`
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_ID=

# Inscription (URL secrète)
SIGNUP_SECRET_TOKEN=

# API d'administration (/api/drafts, /api/catalog) — clé Bearer des agents de collecte et de `npm run verify:drafts`
ADMIN_API_KEY=
# Site visé par `npm run verify:drafts` (défaut : http://localhost:3000 ; en production : https://debats.co)
DEBATS_URL=
# Contributeur au nom duquel l'API d'administration écrit dans le journal (métiers, affiliations, organisations) : l'id d'une ligne de `contributors`, de rang Éloquent au moins
ADMIN_CONTRIBUTOR_ID=

# Import de contenu (optionnel)
CONTENT_AUTHOR_ID=00000000-0000-0000-0000-000000000001

# SMTP (envoi d'emails — feedback visiteurs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sentry (production uniquement — ne pas définir en dev pour garder Sentry inactif)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Connexion Postgres directe de la couche d'écriture (Prisma). Local : base de supabase start ; prod : pooler Supabase
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:64322/postgres

# Relecture assistée du formulaire de prise de position (ADR 0002). Sans clé, la relecture se dit indisponible
ANTHROPIC_API_KEY=
