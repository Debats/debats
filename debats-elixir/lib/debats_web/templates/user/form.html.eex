<%= form_for @changeset, @action, fn f -> %>
  <%= if @changeset.action do %>
    <div class="alert alert-danger">
      <p>Oops, quelque chose s’est mal passé ! Merci de vérifier votre saisie.</p>
    </div>
  <% end %>

  <label>Nom</label>
  <%= text_input f, :name %>
  <%= error_tag f, :name %>

  <label>E-mail</label>
  <%= text_input f, :email %>
  <%= error_tag f, :email %>

  <%= inputs_for f, :credential, fn c -> %>

    <label>Mot de passe</label>
    <%= password_input c, :password, placeholder: "Mot de passe" %>
    <%= error_tag c, :password %>

  <% end %>

  <div>
    <%= submit "Valider" %>
  </div>
<% end %>
