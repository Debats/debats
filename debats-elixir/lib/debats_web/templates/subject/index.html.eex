<h1>Les sujets</h1>

<span><%= link "Référencer un sujet", to: Routes.subject_path(@conn, :new) %></span>

<ul>
<%= for subject <- @subjects do %>
    <li>
        <h2><%= link subject.title, to: Routes.subject_path(@conn, :show, subject) %></h2>
        <div><ul><li><%= length(subject.positions) %> positions</li><li>39 personnalités</li><li>42 prises de position</li></ul></div>
        <p><%= subject.description %></p>
    </li>
<% end %>
</ul>

