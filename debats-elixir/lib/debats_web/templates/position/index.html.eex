<h1>Listing Positions</h1>

<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>

      <th></th>
    </tr>
  </thead>
  <tbody>
<%= for position <- @positions do %>
    <tr>
      <td><%= position.title %></td>
      <td><%= position.description %></td>

      <td>
        <span><%= link "Show", to: Routes.position_path(@conn, :show, position) %></span>
        <span><%= link "Edit", to: Routes.position_path(@conn, :edit, position) %></span>
        <span><%= link "Delete", to: Routes.position_path(@conn, :delete, position), method: :delete, data: [confirm: "Are you sure?"] %></span>
      </td>
    </tr>
<% end %>
  </tbody>
</table>

<span><%= link "New Position", to: Routes.position_path(@conn, :new) %></span>
