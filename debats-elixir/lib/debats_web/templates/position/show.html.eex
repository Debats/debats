<h1>Show Position</h1>

<ul>

  <li>
    <strong>Title:</strong>
    <%= @position.title %>
  </li>

  <li>
    <strong>Description:</strong>
    <%= @position.description %>
  </li>

</ul>

<span><%= link "Edit", to: Routes.position_path(@conn, :edit, @position) %></span>
<span><%= link "Back", to: Routes.position_path(@conn, :index) %></span>
