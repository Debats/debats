<h1>Listing Statements</h1>

<table>
  <thead>
    <tr>
      <th>Evidence source</th>
      <th>Evidence url</th>
      <th>Quote</th>
      <th>Date</th>

      <th></th>
    </tr>
  </thead>
  <tbody>
<%= for statement <- @statements do %>
    <tr>
      <td><%= statement.evidence_source %></td>
      <td><%= statement.evidence_url %></td>
      <td><%= statement.quote %></td>
      <td><%= statement.date %></td>

      <td>
        <span><%= link "Show", to: Routes.statement_path(@conn, :show, statement) %></span>
        <span><%= link "Edit", to: Routes.statement_path(@conn, :edit, statement) %></span>
        <span><%= link "Delete", to: Routes.statement_path(@conn, :delete, statement), method: :delete, data: [confirm: "Are you sure?"] %></span>
      </td>
    </tr>
<% end %>
  </tbody>
</table>

<span><%= link "New Statement", to: Routes.statement_path(@conn, :new) %></span>
