<h1>Login</h1>

<%= form_for @conn,
    Routes.session_path(@conn, :create),
    [as: :session],
    fn f -> %>

    <div>
        <%= text_input f, :email, placeholder: "Adresse e-mail" %>
    </div>

    <div>
        <%= password_input f, :password, placeholder: "Mot de passe" %>
    </div>

    <%= submit "Log in"  %>
<% end %>
